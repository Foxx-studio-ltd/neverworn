 "char": {
  "id": "bea",
  "handle": "bea_from_suffolk",
  "name": "Bea",
  "bio": "Local. I know where the lights are.",
  "voice": "bf_emma",
  "case": "rendlesham",
  "look": {
   "skin": "#f2d6c4",
   "hair": "#c4a24a",
   "style": "bun",
   "shirt": "#5a6b3a",
   "glasses": true,
   "extra": "none"
  },
  "script": "I grew up next to Rendlesham Forest in Suffolk. In December 1980, American airmen from the base said they saw strange lights coming down through the trees. Their deputy commander wrote a memo to the Ministry of Defence, and people started calling it Britain's Roswell. Here's what nobody from outside tells you. Back then, from that forest at night, you could see the Orford Ness lighthouse flashing through the pines. I'm not saying that explains everything. I'm saying start there."
 },
