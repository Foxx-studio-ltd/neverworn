 "char": {
  "id": "bea2",
  "handle": "bea_from_suffolk",
  "name": "Bea",
  "bio": "Local. I know where the lights are.",
  "voice": "bf_emma",
  "case": "mincemeat",
  "look": {
   "skin": "#f2d6c4",
   "hair": "#c4a24a",
   "style": "bun",
   "shirt": "#5a6b3a",
   "glasses": true,
   "extra": "none"
  },
  "script": "My grandad told me this one. In 1943, British intelligence dressed a dead man as a Royal Marines officer, chained a briefcase of fake letters to him, and let him wash up off the coast of Spain. The letters said the Allies would invade Greece. Hitler's spies believed every word. In July, the Allies landed in Sicily instead. They called it Operation Mincemeat. The man was Glyndwr Michael, a homeless Welshman. His grave in Spain finally carries his real name."
 },
