 "char": {
  "id": "dave",
  "handle": "deep_water_dave",
  "name": "Dave",
  "bio": "Twenty years in salvage. Ask me about the sea floor.",
  "voice": "am_onyx",
  "case": "azorian",
  "look": {
   "skin": "#d8a882",
   "hair": "#6b6b6b",
   "style": "bald",
   "shirt": "#24394f",
   "glasses": false,
   "extra": "mask"
  },
  "script": "I spent twenty years in commercial salvage, so this one gets me. In 1968 a Soviet submarine, K-129, sank in the Pacific. The CIA wanted it. So they built a giant ship and told the world it belonged to Howard Hughes and was mining the ocean floor. In 1974 they lowered a claw about five kilometres down and lifted part of the sub. The cover story worked. And the ship's name still lives on. A Glomar response means: we can neither confirm nor deny."
 },
 "hue": null,
