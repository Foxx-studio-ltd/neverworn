 "char": {
  "id": "theo",
  "handle": "theo_reads_memos",
  "name": "Theo",
  "bio": "Declassified documents, read so you don't have to.",
  "voice": "am_michael",
  "case": "northwoods",
  "look": {
   "skin": "#8a5a3c",
   "hair": "#141014",
   "style": "short",
   "shirt": "#c9b06a",
   "glasses": true,
   "extra": "beard"
  },
  "script": "I read declassified documents for fun. Here's the one that changed how I see everything. March 1962. Operation Northwoods. America's Joint Chiefs of Staff signed a memo proposing fake attacks. A staged hijacking. A ship blown up at Guantanamo. A terror campaign in Miami. All to be blamed on Cuba. Kennedy's team said no. We only know because it was declassified in 1997. So when someone tells me they'd never do that, I say: they wrote it down."
 },
